# Le front lit SUPABASE_URL et SUPABASE_ANON_KEY de l'environnement (voir vite.config.ts) : VITE_SUPABASE_* est facultatif (absent ou vide, le front retombe sur SUPABASE_URL et SUPABASE_ANON_KEY).
# Copier en .env (front) ou .env.test (tests E2E). Ne jamais commiter les fichiers .env.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=

# Tests E2E uniquement (.env.test) : préparation des données, jamais côté client.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=

# Edge Functions uniquement (supabase/functions/.env) : jamais dans le front.
ANTHROPIC_API_KEY=

# Envoi des e-mails de connexion (supabase/functions/.env, ou secrets du projet).
# Secret du hook Send Email au format v1,whsec_… (tableau de bord Auth > Hooks).
SEND_EMAIL_HOOK_SECRET=
# boite-de-test (développement) ; aucun fournisseur d'e-mail pour l'instant (story #45).
MODE_EMAIL=boite-de-test
