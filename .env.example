# Le front lit SUPABASE_URL et SUPABASE_ANON_KEY de l'environnement (voir vite.config.ts) : VITE_SUPABASE_* est facultatif (absent ou vide, le front retombe sur SUPABASE_URL et SUPABASE_ANON_KEY).
# Copier en .env (front) ou .env.test (tests E2E). Ne jamais commiter les fichiers .env.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=

# Tests E2E uniquement (.env.test) : préparation des données, jamais côté client.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=

# Edge Functions uniquement (supabase/functions/.env) : jamais dans le front.
ANTHROPIC_API_KEY=

# Envoi des e-mails de connexion (supabase/functions/.env, ou secrets du projet).
# Secret du hook Send Email au format v1,whsec_… (tableau de bord Auth > Hooks).
SEND_EMAIL_HOOK_SECRET=
# boite-de-test (développement) ; aucun fournisseur d'e-mail pour l'instant (story #45).
MODE_EMAIL=boite-de-test
# MODE_EMAIL est interdit sur le projet de production pendant la beta (aucun e-mail envoyé, vérifié par la publication).

# Edge Functions (secrets du projet) : adresses du front autorisées par CORS, séparées par des virgules (adresse de production, jamais localhost en production).
ORIGINES_AUTORISEES=

# Publication (story #45), jamais commités ni dans le front. Voir docs/publication.md.
# Adresse de production du front (https://…), contrôlée par playwright.production.config.ts.
ADRESSE_DE_PRODUCTION=
# Référence du projet Supabase de production (tableau de bord, Project Settings).
SUPABASE_PRODUCTION_REF=
# URL de l'API du projet Supabase de production.
SUPABASE_PRODUCTION_URL=
# Clé publique anon du projet de production (jamais la clé service_role).
SUPABASE_PRODUCTION_ANON_KEY=
# Parent de test de la production (45.18) : adresse e-mail de son compte.
PARENT_DE_TEST_PRODUCTION_EMAIL=
# Parent de test de la production : mot de passe.
PARENT_DE_TEST_PRODUCTION_MOT_DE_PASSE=
# Adresse WebDAV du site alwaysdata, pour envoyer le front.
ALWAYSDATA_WEBDAV_URL=
# Utilisateur WebDAV d'alwaysdata.
ALWAYSDATA_WEBDAV_UTILISATEUR=
# Mot de passe WebDAV d'alwaysdata.
ALWAYSDATA_WEBDAV_MOT_DE_PASSE=
# Identité de l'éditeur des pages légales, lue au build du front (absente : valeurs fictives exemple.test, refusées par le contrôle du build).
VITE_EDITEUR=
# Directeur de la publication (mentions légales).
VITE_DIRECTEUR_DE_PUBLICATION=
# Adresse de contact (demandes de suppression des données, mentions légales).
VITE_ADRESSE_DE_CONTACT=
