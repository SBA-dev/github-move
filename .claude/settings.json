{
  "permissions": {
    "allow": [
      "Bash(curl * https://api.supabase.com/v1/projects/*/database/*)",
      "mcp__github__merge_pull_request",
      "Bash(gh pr merge * --merge*)",
      "Bash(python3 scripts/exploitation/migrations.py*)",
      "Bash(python3 scripts/exploitation/deploiement_des_fonctions.py*)",
      "Bash(npx supabase secrets set *)",
      "Bash(PYTHONPATH=scripts python3 -c *auth_de_production*)",
      "Bash(VITE_SUPABASE_URL=* VITE_SUPABASE_ANON_KEY=* npm run build*)",
      "Bash(python3 scripts/exploitation/secrets_du_build.py*)",
      "Bash(python3 scripts/exploitation/envoi_webdav.py*)",
      "Bash(env -u SUPABASE_SERVICE_ROLE_KEY python3 scripts/exploitation/controles_production.py*)",
      "Bash(env -u SUPABASE_SERVICE_ROLE_KEY npx bddgen -c playwright.production.config.ts*)",
      "Bash(env -u SUPABASE_SERVICE_ROLE_KEY npx playwright test -c playwright.production.config.ts*)"
    ]
  },
  "extraKnownMarketplaces": {
    "context-mode": {
      "source": {
        "source": "github",
        "repo": "mksglu/context-mode",
        "ref": "v1.0.169"
      }
    },
    "claude-plugins-official": {
      "source": {
        "source": "github",
        "repo": "anthropics/claude-plugins-official",
        "ref": "58267944f92187b7d6a1c822165c96c81c864806"
      }
    },
    "knowledge-work-plugins": {
      "source": {
        "source": "github",
        "repo": "anthropics/knowledge-work-plugins",
        "ref": "33d3dea41a341b341d4f5da2e8801ae0c89be2b8"
      }
    },
    "education-agent-skills": {
      "source": {
        "source": "github",
        "repo": "GarethManning/education-agent-skills",
        "ref": "v3.1.0"
      }
    },
    "genjutsu": {
      "source": {
        "source": "github",
        "repo": "AThevon/genjutsu",
        "ref": "v4.1.1"
      }
    }
  },
  "enabledPlugins": {
    "context-mode@context-mode": true,
    "frontend-design@claude-plugins-official": true,
    "design@knowledge-work-plugins": true,
    "education-agent-skills@education-agent-skills": true,
    "genjutsu@genjutsu": true
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.sh"
          }
        ]
      }
    ]
  }
}
